# ============================================================
# Casa dos Duques — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ============================================================

# ---- SMTP (Gmail) ----
# Create an App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fernando@casadosduques.pt
SMTP_PASS=your-16-char-app-password

# ---- Email addresses ----
EMAIL_FROM=fernando@casadosduques.pt
EMAIL_TO=fernando@casadosduques.pt

# ---- Server ----
PORT=3000
