---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { SITE_CONFIG } from '../data/site-config.ts';
import { buildVacationRentalSchema } from '../lib/schema';

const schema = buildVacationRentalSchema('en');
---

<BaseLayout
  title="Casa dos Duques | Holiday Home in Abiul, Pombal, Central Portugal"
  description={SITE_CONFIG.description}
  schema={schema}
>

  <!-- Hero -->
  <Hero
    title={SITE_CONFIG.name}
    subtitle={SITE_CONFIG.tagline}
    primaryCta={{ label: 'Check availability', href: '/booking/' }}
    secondaryCta={{ label: 'Explore the house', href: '/the-house/' }}
    image="/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg"
  />

  <!-- Quick facts bar -->
  <div class="bg-white border-b border-stone-200">
    <div class="max-w-6xl mx-auto px-4 py-4">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-muted font-body">
        <span class="flex items-center gap-2">
          <span class="text-terracotta-500 text-lg leading-none">★</span>
          <span class="font-semibold text-wood-800">{SITE_CONFIG.rating}</span>
          Guest Favorite · {SITE_CONFIG.reviewCount} reviews
        </span>
        <span>8 guests</span>
        <span class="hidden sm:inline">·</span>
        <span>4 bedrooms</span>
        <span class="hidden sm:inline">·</span>
        <span>5 beds</span>
        <span class="hidden sm:inline">·</span>
        <span>3 bathrooms</span>
        <span class="hidden sm:inline">·</span>
        <span>Private pool</span>
        <span class="hidden sm:inline">·</span>
        <span>450 m² garden</span>
      </div>
    </div>
  </div>

  <!-- Photo tour — masonry-style collage -->
  <section class="bg-white pb-2">
    <div class="max-w-6xl mx-auto px-4 pt-8">
      <div class="grid grid-cols-4 grid-rows-2 gap-2 max-h-[480px]">
        <div class="col-span-2 row-span-2">
          <a href="/garden/">
            <OptimizedImage src="/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg" alt="Pool and garden at Casa dos Duques" class="h-full w-full object-cover hover:brightness-95 transition" loading="eager" width={800} height={533} sizes="50vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1">
          <a href="/rooms/">
            <OptimizedImage src="/images/airbnb/c1eb8904-37f7-4f82-99e7-cd539bafd98a.jpeg" alt="Bedroom at Casa dos Duques" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1">
          <a href="/the-house/">
            <OptimizedImage src="/images/airbnb/d5facc44-501a-445c-8eb4-94cf90e682dc.jpeg" alt="Casa dos Duques exterior" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1">
          <a href="/garden/">
            <OptimizedImage src="/images/airbnb/16b41c25-33a1-4607-9919-e7076c85ba9c.jpeg" alt="Private pool area" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1 relative">
          <a href="/rooms/">
            <OptimizedImage src="/images/airbnb/1a43a296-ac44-498b-86ee-c004d600177c.jpeg" alt="Living space at Casa dos Duques" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
            <span class="absolute bottom-2 right-2 bg-white px-3 py-1.5 text-xs font-semibold text-wood-800">All photos</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The House at a Glance — prose + image, no stat grid -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <div class="flex flex-col md:flex-row gap-10 items-center">
        <div class="md:w-1/2">
          <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">The house</p>
          <h2 class="mb-5">A 90-year-old house, restored with soul</h2>
          <div class="prose-casa font-body text-muted leading-relaxed space-y-4">
            <p>
              Casa dos Duques has stood in the heart of Abiul for over 90 years. Thick stone walls,
              original terracotta floors, high ceilings, and exposed wooden beams — every detail tells
              the story of traditional Portuguese craftsmanship.
            </p>
            <p>
              Restored with deep respect for its original character, the house sleeps eight guests across
              four bedrooms, with three bathrooms, a fully equipped kitchen, and a cozy living room with
              a fireplace. Thick walls keep it naturally cool in summer and warm in winter.
            </p>
            <p class="text-sm text-wood-600">
              4 bedrooms &ensp;·&ensp; 5 beds &ensp;·&ensp; 3 bathrooms &ensp;·&ensp; Sleeps 8
              &ensp;·&ensp; 10 min to Pombal &ensp;·&ensp; 35–40 min to beaches
            </p>
          </div>
        </div>
        <div class="md:w-1/2">
          <OptimizedImage src="/images/airbnb/d5facc44-501a-445c-8eb4-94cf90e682dc.jpeg" alt="Casa dos Duques exterior" class="w-full h-80 md:h-96 object-cover" loading="lazy" width={800} height={600} sizes="(max-width: 768px) 100vw, 50vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Thin terracotta rule — signature mortar-joint divider -->
  <div class="max-w-6xl mx-auto px-4"><hr class="border-terracotta-200" /></div>

  <!-- Why Guests Love It -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 text-center font-body">Why guests love it</p>
      <h2 class="mb-10 text-center">Three things that make this place special</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center md:text-left">
          <div class="text-terracotta-500 text-4xl font-light mb-4">&mdash;</div>
          <h3 class="text-xl mb-3">Pool &amp; Garden</h3>
          <p class="text-muted font-body text-sm leading-relaxed">
            8-metre swimming pool, 450 m&sup2; garden with lounge areas, barbecue terrace —
            your private outdoor retreat in the Portuguese sun.
          </p>
          <a href="/garden/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-3 font-body">See the garden &rarr;</a>
        </div>
        <div class="text-center md:text-left">
          <div class="text-terracotta-500 text-4xl font-light mb-4">&mdash;</div>
          <h3 class="text-xl mb-3">Restored with Soul</h3>
          <p class="text-muted font-body text-sm leading-relaxed">
            Original stone walls, terracotta floor tiles, high ceilings, exposed wooden beams —
            a careful restoration that honours the house&rsquo;s 90-year history.
          </p>
          <a href="/the-house/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-3 font-body">The full story &rarr;</a>
        </div>
        <div class="text-center md:text-left">
          <div class="text-terracotta-500 text-4xl font-light mb-4">&mdash;</div>
          <h3 class="text-xl mb-3">Central Location</h3>
          <p class="text-muted font-body text-sm leading-relaxed">
            10 minutes to Pombal, 30 to Batalha and Leiria, 35–40 to beaches. Four UNESCO World Heritage
            sites within a 35-minute drive.
          </p>
          <a href="/location/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-3 font-body">Explore the area &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Garden Gallery -->
  <section class="bg-stone-100">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 text-center font-body">Outdoors</p>
      <h2 class="mb-8 text-center">The Garden &amp; Pool</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto">
        <OptimizedImage src="/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg" alt="Garden view" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
        <OptimizedImage src="/images/airbnb/16b41c25-33a1-4607-9919-e7076c85ba9c.jpeg" alt="Pool area" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
        <OptimizedImage src="/images/airbnb/1e2a954f-adf1-4b6a-8df9-1e23ff619dc4.jpeg" alt="Backyard and garden area" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
        <OptimizedImage src="/images/airbnb/fbe29248-4838-4933-8a45-8cb4fa287fbf.jpeg" alt="Backyard terrace area" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
      </div>
      <div class="text-center mt-6">
        <a href="/garden/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold font-body">See the garden &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Explore Central Portugal — compact cards with driving times -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 text-center font-body">Explore</p>
      <h2 class="mb-10 text-center">Central Portugal at your doorstep</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/guide/central-portugal/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Tomar</h3>
          <p class="text-xs text-muted font-body">Convent of Christ · UNESCO</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">40 min</p>
        </a>
        <a href="/guide/central-portugal/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Batalha</h3>
          <p class="text-xs text-muted font-body">Gothic Monastery · UNESCO</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">30 min</p>
        </a>
        <a href="/beaches/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Nazar&eacute;</h3>
          <p class="text-xs text-muted font-body">Big waves &amp; seafood</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">65 min</p>
        </a>
        <a href="/day-trips/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Coimbra</h3>
          <p class="text-xs text-muted font-body">University City · UNESCO</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">50 min</p>
        </a>
      </div>
      <div class="text-center mt-6">
        <a href="/things-to-do/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold font-body">All things to do &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Thin terracotta rule -->
  <div class="max-w-6xl mx-auto px-4"><hr class="border-terracotta-200" /></div>

  <!-- Review pull quote -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-4 py-16 md:py-20 text-center">
      <div class="flex items-center justify-center gap-1 text-terracotta-500 mb-5">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <blockquote class="text-xl md:text-2xl text-wood-700 leading-relaxed mb-5">
        &ldquo;An absolutely stunning house. Every detail has been thought of.
        The garden and pool are incredible, and the location is perfect for
        exploring central Portugal.&rdquo;
      </blockquote>
      <p class="text-sm text-muted font-body mb-6">Ana &amp; Miguel, September 2025</p>
      <div class="flex items-center justify-center gap-2 text-sm font-body">
        <span class="font-semibold text-wood-800">{SITE_CONFIG.rating}</span>
        <span class="text-muted">· Guest Favorite · {SITE_CONFIG.reviewCount} reviews</span>
      </div>
      <a href="/reviews/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-4 font-body">Read all reviews &rarr;</a>
    </div>
  </section>

  <!-- Booking CTA -->
  <CTASection
    title="Ready to book your stay?"
    subtitle="Licensed local accommodation in Abiul, Pombal"
    primaryCta={{ label: 'Book directly with us', href: '/booking/' }}
    secondaryCta={{ label: 'View on Airbnb', href: SITE_CONFIG.airbnbUrl }}
    variant="terracotta"
  />

</BaseLayout>
