---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { exteriorPhotos, poolGardenPhotos } from '../data/photo-manifest';

---

<BaseLayout
  title="450m² Garden & 8m Pool — Photo Gallery | Casa dos Duques"
  description="Browse photos of the 450m² garden, 8m pool, and house exterior at Casa dos Duques. Your private outdoor paradise in Abiul."
  canonical="/garden/"
>
  <div class="max-w-6xl mx-auto px-4 pt-12 pb-6">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Garden &amp; Pool</p>
    <h1 class="mb-4">450 m&sup2; of Garden &amp; Pool</h1>
    <p class="text-muted font-body leading-relaxed max-w-3xl">
      Explore every corner of Casa dos Duques through our complete collection of photographs.
      From the sun-drenched pool and lush garden to the charming exterior — see the outdoor spaces before you arrive.
    </p>
  </div>

  <div class="max-w-6xl mx-auto px-4 pb-12">

    <section class="mb-16" id="pool-garden">
      <h2 class="mb-2">Pool &amp; Garden</h2>
      <p class="text-muted font-body mb-6">The heart of your outdoor retreat — pool, lounge areas, and lush greenery</p>
      <div class="gallery-grid columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
        {
          poolGardenPhotos.map((photo) => (
            <OptimizedImage
              src={photo.src}
              alt={photo.alt}
              class="gallery-thumb w-full hover:transition-all duration-300 cursor-pointer object-cover"
              pictureClass="w-full break-inside-avoid border border-stone-200"
              loading="lazy"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw"
            />
          ))
        }
      </div>
    </section>

    <section class="mb-16" id="house-exterior">
      <h2 class="mb-2">House Exterior</h2>
      <p class="text-muted font-body mb-6">The charming facade and surroundings of Casa dos Duques</p>
      <div class="gallery-grid columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
        {
          exteriorPhotos.map((photo) => (
            <OptimizedImage
              src={photo.src}
              alt={photo.alt}
              class="gallery-thumb w-full hover:transition-all duration-300 cursor-pointer object-cover"
              pictureClass="w-full break-inside-avoid border border-stone-200"
              loading="lazy"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw"
            />
          ))
        }
      </div>
    </section>

  </div>

  <!-- Lightbox Overlay -->
  <div id="lightbox" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm hidden items-center justify-center p-4">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white/80 hover:text-white text-4xl z-10 w-12 h-12 flex items-center justify-center bg-black/30 hover:bg-black/50 transition-colors">&times;</button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white text-5xl z-10 w-12 h-12 flex items-center justify-center bg-black/30 hover:bg-black/50 transition-colors">&#8249;</button>
    <img id="lightbox-img" class="max-h-[90vh] max-w-[90vw] object-contain shadow-2xl" alt="Enlarged view" />
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white text-5xl z-10 w-12 h-12 flex items-center justify-center bg-black/30 hover:bg-black/50 transition-colors">&#8250;</button>
  </div>

  <CTASection
    title="Experience the Garden"
    subtitle="Book your stay and enjoy your private outdoor paradise"
    primaryCta={{ label: 'Check availability', href: '/booking/' }}
    variant="wood"
  />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentIndex = 0;
    let allImages = [];

    document.querySelectorAll('.gallery-thumb').forEach((img, index) => {
      allImages.push(img);
      img.addEventListener('click', () => openLightbox(index));
    });

    function openLightbox(index) {
      currentIndex = index;
      updateLightboxImage();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function updateLightboxImage() {
      const img = allImages[currentIndex];
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function prevImage() {
      currentIndex = (currentIndex - 1 + allImages.length) % allImages.length;
      updateLightboxImage();
    }

    function nextImage() {
      currentIndex = (currentIndex + 1) % allImages.length;
      updateLightboxImage();
    }

    closeBtn.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', prevImage);
    nextBtn.addEventListener('click', nextImage);

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('flex')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'ArrowRight') nextImage();
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    let touchStartX = 0;
    let touchEndX = 0;

    lightbox.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightbox.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) nextImage();
        else prevImage();
      }
    }, { passive: true });
  });
</script>

<style>
  .gallery-grid {
    column-gap: 1rem;
  }
  .gallery-grid > picture {
    margin-bottom: 1rem;
    display: block;
  }
  .gallery-grid > picture > img {
    display: block;
    width: 100%;
  }
  @media (max-width: 639px) {
    .gallery-grid {
      columns: 1;
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .gallery-grid {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .gallery-grid {
      columns: 3;
    }
  }

  .gallery-thumb {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .gallery-thumb:hover {
    transform: scale(1.01);
  }

  #lightbox {
    animation: fadeIn 0.2s ease;
  }
  #lightbox-img {
    animation: scaleIn 0.25s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes scaleIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  section {
    scroll-margin-top: 2rem;
  }
</style>
