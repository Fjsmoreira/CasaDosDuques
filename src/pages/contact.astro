---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapSection from '../components/MapSection.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_CONFIG } from '../data/site-config.ts';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Casa dos Duques',
  url: 'https://casadosduques.pt/contact/',
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE_CONFIG.contact.email,
    telephone: SITE_CONFIG.contact.phone,
    contactType: 'reservation',
  },
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE_CONFIG.address.street,
      addressLocality: SITE_CONFIG.address.town,
      postalCode: SITE_CONFIG.address.postcode,
      addressRegion: SITE_CONFIG.address.district,
      addressCountry: 'PT',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: SITE_CONFIG.coordinates.lat,
      longitude: SITE_CONFIG.coordinates.lng,
    },
  },
};
---

<BaseLayout
  title="Contact Casa dos Duques — Holiday Home in Abiul, Pombal, Central Portugal"
  description="Contact Fernando & Isabelle at Casa dos Duques. Email, phone, WhatsApp, or use our contact form. We look forward to welcoming you to Abiul, Pombal."
  canonical="/contact/"
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Contact</p>
    <h1 class="mb-6">Get in touch</h1>
    <p class="text-muted font-body mb-10">
      We&rsquo;d love to hear from you. Whether you have a question, want to check availability,
      or are ready to book &mdash; get in touch and we&rsquo;ll respond promptly.
    </p>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="space-y-4">
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Email</h3>
          <a href="mailto:{SITE_CONFIG.contact.email}" class="text-terracotta-500 hover:text-terracotta-600 text-sm font-body">{SITE_CONFIG.contact.email}</a>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Phone / WhatsApp</h3>
          <p class="text-muted text-sm font-body">{SITE_CONFIG.contact.phone}</p>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Address</h3>
          <p class="text-sm text-muted font-body">
            {SITE_CONFIG.address.street}<br />
            {SITE_CONFIG.address.town}, {SITE_CONFIG.address.postcode}<br />
            {SITE_CONFIG.address.district}, {SITE_CONFIG.address.country}
          </p>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">AL Registration</h3>
          <p class="text-sm text-muted font-body">{SITE_CONFIG.alRegistration} &mdash; Licensed Local Accommodation</p>
        </div>
      </div>

      <ContactForm locale="en" />
    </div>

    <MapSection
      lat={SITE_CONFIG.coordinates.lat}
      lng={SITE_CONFIG.coordinates.lng}
      address={SITE_CONFIG.address.street}
      town={SITE_CONFIG.address.town}
      district={SITE_CONFIG.address.district}
      height="h-[300px] md:h-[400px]"
    />
  </div>
</BaseLayout>
