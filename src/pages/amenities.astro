---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  title="Amenities — Everything Included at Casa dos Duques | Abiul, Pombal"
  description="Pool, 450m² garden, BBQ, fireplace, fully equipped kitchen, WiFi, parking — everything you need for a perfect holiday in Central Portugal."
  canonical="/amenities/"
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Amenities</p>
    <h1 class="mb-4">Everything you need</h1>
    <p class="text-muted font-body mb-10">Everything for a comfortable, memorable stay.</p>

    <div class="grid md:grid-cols-2 gap-5 mb-12">
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">Swimming Pool</h3>
        <p class="text-sm text-muted font-body">8-metre pool. Available May–September. <em>No gate or lock — children must be supervised.</em></p>
      </div>
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">Garden</h3>
        <p class="text-sm text-muted font-body">450 m&sup2; with several lounge areas, perfect for relaxing, sunbathing, and playing.</p>
      </div>
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">BBQ &amp; Terrace</h3>
        <p class="text-sm text-muted font-body">Outdoor barbecue and terrace for al fresco dining under the stars.</p>
      </div>
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">Fully Equipped Kitchen</h3>
        <p class="text-sm text-muted font-body">Oven, fridge, Nespresso machine, kettle, microwave, and all utensils.</p>
      </div>
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">Fireplace</h3>
        <p class="text-sm text-muted font-body">Cozy living room with fireplace for cooler evenings.</p>
      </div>
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">WiFi</h3>
        <p class="text-sm text-muted font-body">Free high-speed wireless internet throughout.</p>
      </div>
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">Free Parking</h3>
        <p class="text-sm text-muted font-body">On-site parking available.</p>
      </div>
      <div class="bg-white border border-stone-200 p-6">
        <h3 class="mb-1">Essentials</h3>
        <p class="text-sm text-muted font-body">Bed linen, towels, shampoo, hair dryer included.</p>
      </div>
    </div>

    <div class="bg-stone-100 p-6 mb-10">
      <h3 class="mb-2">Please Note</h3>
      <ul class="text-sm text-muted font-body space-y-1">
        <li>No air conditioning — thick stone walls keep the house naturally cool in summer</li>
        <li>No washer/dryer</li>
        <li>Pool has no gate/lock — supervision essential for children</li>
        <li>May not be suitable for guests with limited mobility</li>
      </ul>
    </div>
  </div>

  <CTASection
    title="Book your stay"
    primaryCta={{ label: 'Check availability', href: '/booking/' }}
    variant="terracotta"
  />
</BaseLayout>
