---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTASection from '../../components/CTASection.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { SITE_CONFIG } from '../../data/site-config.ts';
import { buildVacationRentalSchema } from '../../lib/schema';

const description =
  'Casa recuperada de 90 anos em Abiul, Pombal. Dorme 8 hóspedes, 4 quartos, piscina, jardim de 450m². Perfeita para explorar o Centro de Portugal.';
const schema = buildVacationRentalSchema('pt', description);
---

<BaseLayout
  title="Casa dos Duques | Casa de Férias em Abiul, Pombal, Centro de Portugal"
  description={description}
  canonical="/pt/"
  locale="pt"
  schema={schema}
>

  <Hero
    title="Casa dos Duques"
    subtitle="A Sua Casa de F&eacute;rias no Centro de Portugal"
    primaryCta={{ label: 'Ver disponibilidade', href: '/pt/reserva/' }}
    secondaryCta={{ label: 'Conhecer a casa', href: '/pt/a-casa/' }}
    image="/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg"
  />

  <!-- Quick facts bar -->
  <div class="bg-white border-b border-stone-200">
    <div class="max-w-6xl mx-auto px-4 py-4">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-muted font-body">
        <span class="flex items-center gap-2">
          <span class="text-terracotta-500 text-lg leading-none">★</span>
          <span class="font-semibold text-wood-800">{SITE_CONFIG.rating}</span>
          Guest Favorite · {SITE_CONFIG.reviewCount} avalia&ccedil;&otilde;es
        </span>
        <span>8 h&oacute;spedes</span>
        <span class="hidden sm:inline">·</span>
        <span>4 quartos</span>
        <span class="hidden sm:inline">·</span>
        <span>5 camas</span>
        <span class="hidden sm:inline">·</span>
        <span>3 casas de banho</span>
        <span class="hidden sm:inline">·</span>
        <span>Piscina privada</span>
        <span class="hidden sm:inline">·</span>
        <span>450 m² jardim</span>
      </div>
    </div>
  </div>

  <!-- Photo tour -->
  <section class="bg-white pb-2">
    <div class="max-w-6xl mx-auto px-4 pt-8">
      <div class="grid grid-cols-4 grid-rows-2 gap-2 max-h-[480px]">
        <div class="col-span-2 row-span-2">
          <a href="/pt/jardim/">
            <OptimizedImage src="/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg" alt="Piscina e jardim na Casa dos Duques" class="h-full w-full object-cover hover:brightness-95 transition" loading="eager" width={800} height={600} sizes="50vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1">
          <a href="/pt/quartos/">
            <OptimizedImage src="/images/airbnb/c1eb8904-37f7-4f82-99e7-cd539bafd98a.jpeg" alt="Quarto na Casa dos Duques" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1">
          <a href="/pt/a-casa/">
            <OptimizedImage src="/images/airbnb/d5facc44-501a-445c-8eb4-94cf90e682dc.jpeg" alt="Exterior da Casa dos Duques" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1">
          <a href="/pt/jardim/">
            <OptimizedImage src="/images/airbnb/16b41c25-33a1-4607-9919-e7076c85ba9c.jpeg" alt="Piscina privada" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
          </a>
        </div>
        <div class="col-span-1 row-span-1 relative">
          <a href="/pt/quartos/">
            <OptimizedImage src="/images/airbnb/1a43a296-ac44-498b-86ee-c004d600177c.jpeg" alt="Sala de estar na Casa dos Duques" class="h-full w-full object-cover hover:brightness-95 transition" loading="lazy" width={400} height={300} sizes="25vw" />
            <span class="absolute bottom-2 right-2 bg-white px-3 py-1.5 text-xs font-semibold text-wood-800">Todas as fotos</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- A Casa -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <div class="flex flex-col md:flex-row gap-10 items-center">
        <div class="md:w-1/2">
          <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">A casa</p>
          <h2 class="mb-5">Uma casa de 90 anos, restaurada com alma</h2>
          <div class="font-body text-muted leading-relaxed space-y-4">
            <p>
              A Casa dos Duques ergue-se no cora&ccedil;&atilde;o de Abiul h&aacute; mais de 90 anos.
              Paredes de pedra espessas, soalho de terracota original, tectos altos e vigas de madeira
              &agrave; vista — cada detalhe conta a hist&oacute;ria do artesanato tradicional portugu&ecirc;s.
            </p>
            <p>
              Restaurada com profundo respeito pelo seu car&aacute;cter original, a casa dorme oito
              pessoas em quatro quartos, com tr&ecirc;s casas de banho, uma cozinha totalmente equipada
              e uma acolhedora sala de estar com lareira.
            </p>
            <p class="text-sm text-wood-600">
              4 quartos &ensp;·&ensp; 5 camas &ensp;·&ensp; 3 casas de banho &ensp;·&ensp; 8 h&oacute;spedes
              &ensp;·&ensp; 10 min de Pombal &ensp;·&ensp; 35–40 min das praias
            </p>
          </div>
        </div>
        <div class="md:w-1/2">
          <OptimizedImage src="/images/airbnb/d5facc44-501a-445c-8eb4-94cf90e682dc.jpeg" alt="Exterior da Casa dos Duques" class="w-full h-80 md:h-96 object-cover" loading="lazy" width={800} height={600} sizes="(max-width: 768px) 100vw, 50vw" />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4"><hr class="border-terracotta-200" /></div>

  <!-- Porquê os hóspedes adoram -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 text-center font-body">Porqu&ecirc; os h&oacute;spedes adoram</p>
      <h2 class="mb-10 text-center">Tr&ecirc;s coisas que tornam este lugar especial</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center md:text-left">
          <div class="text-terracotta-500 text-4xl font-light mb-4">&mdash;</div>
          <h3 class="text-xl mb-3">Piscina &amp; Jardim</h3>
          <p class="text-muted font-body text-sm leading-relaxed">
            Piscina de 8 metros, jardim de 450 m&sup2; com zonas de estar, terra&ccedil;o com churrasqueira — o seu para&iacute;so privado ao ar livre sob o sol portugu&ecirc;s.
          </p>
          <a href="/pt/jardim/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-3 font-body">Ver o jardim &rarr;</a>
        </div>
        <div class="text-center md:text-left">
          <div class="text-terracotta-500 text-4xl font-light mb-4">&mdash;</div>
          <h3 class="text-xl mb-3">Restaurada com Alma</h3>
          <p class="text-muted font-body text-sm leading-relaxed">
            Paredes de pedra originais, soalho de terracota, tectos altos, vigas de madeira — um restauro cuidadoso que honra a hist&oacute;ria de 90 anos da casa.
          </p>
          <a href="/pt/a-casa/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-3 font-body">A hist&oacute;ria completa &rarr;</a>
        </div>
        <div class="text-center md:text-left">
          <div class="text-terracotta-500 text-4xl font-light mb-4">&mdash;</div>
          <h3 class="text-xl mb-3">Localiza&ccedil;&atilde;o Central</h3>
          <p class="text-muted font-body text-sm leading-relaxed">
            10 minutos de Pombal, 30 da Batalha e Leiria, 35–40 das praias. Quatro locais UNESCO a menos de 35 minutos de carro.
          </p>
          <a href="/pt/localizacao/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-3 font-body">Explorar a regi&atilde;o &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Jardim galeria -->
  <section class="bg-stone-100">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 text-center font-body">Exterior</p>
      <h2 class="mb-8 text-center">O Jardim &amp; a Piscina</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto">
        <OptimizedImage src="/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg" alt="Jardim" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
        <OptimizedImage src="/images/airbnb/16b41c25-33a1-4607-9919-e7076c85ba9c.jpeg" alt="Piscina" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
        <OptimizedImage src="/images/airbnb/1e2a954f-adf1-4b6a-8df9-1e23ff619dc4.jpeg" alt="Jardim e terraço" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
        <OptimizedImage src="/images/airbnb/fbe29248-4838-4933-8a45-8cb4fa287fbf.jpeg" alt="Terraço" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 25vw" />
      </div>
      <div class="text-center mt-6">
        <a href="/pt/jardim/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold font-body">Ver o jardim &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Explorar -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 text-center font-body">Explorar</p>
      <h2 class="mb-10 text-center">O Centro de Portugal &agrave; sua porta</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/pt/o-que-fazer/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Tomar</h3>
          <p class="text-xs text-muted font-body">Convento de Cristo · UNESCO</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">40 min</p>
        </a>
        <a href="/pt/o-que-fazer/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Batalha</h3>
          <p class="text-xs text-muted font-body">Mosteiro Gótico · UNESCO</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">30 min</p>
        </a>
        <a href="/pt/praias/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Nazar&eacute;</h3>
          <p class="text-xs text-muted font-body">Ondas gigantes &amp; marisco</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">65 min</p>
        </a>
        <a href="/pt/passeios/" class="block bg-stone-100 hover:bg-stone-200 transition p-5 group">
          <h3 class="text-base mb-1 group-hover:text-terracotta-500 transition-colors">Coimbra</h3>
          <p class="text-xs text-muted font-body">Cidade Universit&aacute;ria · UNESCO</p>
          <p class="text-xs text-terracotta-500 font-semibold mt-2 font-body">50 min</p>
        </a>
      </div>
      <div class="text-center mt-6">
        <a href="/pt/o-que-fazer/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold font-body">Tudo o que fazer &rarr;</a>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4"><hr class="border-terracotta-200" /></div>

  <!-- Avaliações -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-4 py-16 md:py-20 text-center">
      <div class="flex items-center justify-center gap-1 text-terracotta-500 mb-5">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <blockquote class="text-xl md:text-2xl text-wood-700 leading-relaxed mb-5">
        &ldquo;Uma casa absolutamente deslumbrante! Cada detalhe foi pensado.
        O jardim e a piscina s&atilde;o incr&iacute;veis, e a localiza&ccedil;&atilde;o
        &eacute; perfeita para explorar o centro de Portugal.&rdquo;
      </blockquote>
      <p class="text-sm text-muted font-body mb-6">Ana &amp; Miguel, setembro 2025</p>
      <div class="flex items-center justify-center gap-2 text-sm font-body">
        <span class="font-semibold text-wood-800">{SITE_CONFIG.rating}</span>
        <span class="text-muted">· Guest Favorite · {SITE_CONFIG.reviewCount} avalia&ccedil;&otilde;es</span>
      </div>
      <a href="/pt/avaliacoes/" class="inline-block text-sm text-terracotta-500 hover:text-terracotta-600 font-semibold mt-4 font-body">Ler todas as avalia&ccedil;&otilde;es &rarr;</a>
    </div>
  </section>

  <CTASection
    title="Pronto para reservar?"
    subtitle="Alojamento local licenciado em Abiul, Pombal"
    primaryCta={{ label: 'Reservar diretamente', href: '/pt/reserva/' }}
    secondaryCta={{ label: 'Ver no Airbnb', href: SITE_CONFIG.airbnbUrl }}
    variant="terracotta"
  />
</BaseLayout>
