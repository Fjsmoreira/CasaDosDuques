---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapSection from '../../components/MapSection.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE_CONFIG } from '../../data/site-config.ts';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto Casa dos Duques',
  url: 'https://casadosduques.pt/pt/contato/',
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE_CONFIG.contact.email,
    telephone: SITE_CONFIG.contact.phone,
    contactType: 'reservation',
  },
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE_CONFIG.address.street,
      addressLocality: SITE_CONFIG.address.town,
      postalCode: SITE_CONFIG.address.postcode,
      addressRegion: SITE_CONFIG.address.district,
      addressCountry: 'PT',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: SITE_CONFIG.coordinates.lat,
      longitude: SITE_CONFIG.coordinates.lng,
    },
  },
};
---

<BaseLayout
  title="Contacto — Casa dos Duques, Abiul, Pombal | Casa de Férias"
  description="Contacte Fernando & Isabelle na Casa dos Duques. Email, telefone, WhatsApp ou formulário de contacto. Estamos ansiosos por recebê-lo em Abiul, Pombal."
  canonical="/pt/contato/"
  locale="pt"
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Contacto</p>
    <h1 class="mb-6">Entre em Contacto</h1>
    <p class="text-muted font-body mb-10">
      Gostaríamos muito de ouvir de si. Quer tenha uma dúvida, queira verificar a disponibilidade
      ou esteja pronto para reservar &mdash; entre em contacto e responderemos prontamente.
    </p>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="space-y-4">
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Email</h3>
          <a href="mailto:{SITE_CONFIG.contact.email}" class="text-terracotta-500 hover:text-terracotta-600 text-sm font-body">{SITE_CONFIG.contact.email}</a>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Telefone / WhatsApp</h3>
          <p class="text-muted text-sm font-body">{SITE_CONFIG.contact.phone}</p>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Morada</h3>
          <p class="text-sm text-muted font-body">
            {SITE_CONFIG.address.street}<br />
            {SITE_CONFIG.address.town}, {SITE_CONFIG.address.postcode}<br />
            {SITE_CONFIG.address.district}, {SITE_CONFIG.address.country}
          </p>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Registo AL</h3>
          <p class="text-sm text-muted font-body">{SITE_CONFIG.alRegistration} &mdash; Alojamento Local Licenciado</p>
        </div>
      </div>

      <ContactForm locale="pt" />
    </div>

    <MapSection
      lat={SITE_CONFIG.coordinates.lat}
      lng={SITE_CONFIG.coordinates.lng}
      address={SITE_CONFIG.address.street}
      town={SITE_CONFIG.address.town}
      district={SITE_CONFIG.address.district}
      height="h-[300px] md:h-[400px]"
    />
  </div>
</BaseLayout>
