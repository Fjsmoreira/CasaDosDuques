---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { SITE_CONFIG } from '../data/site-config.ts';
---

<BaseLayout
  title="Casa dos Duques — A 90-Year-Old Renovated Holiday Home in Abiul, Pombal"
  description="Discover the story of Casa dos Duques: a meticulously renovated 90-year-old house with original stones, terracotta floors, high ceilings, and a warm family ambience in Abiul, Pombal."
  canonical="/the-house/"
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">The house</p>
    <h1 class="mb-6">A 90-year-old house, restored with soul</h1>

    <OptimizedImage src="/images/airbnb/d5facc44-501a-445c-8eb4-94cf90e682dc.jpeg" alt="Casa dos Duques exterior" class="w-full mb-10 h-80 md:h-96 object-cover" loading="eager" fetchpriority="high" width={800} height={600} sizes="(max-width: 896px) 100vw, 896px" />

    <section class="mb-12">
      <h2 class="mb-4">The Story of the House</h2>
      <div class="font-body text-muted leading-relaxed space-y-4">
        <p>
          Casa dos Duques has stood in the heart of Abiul for over 90 years. Built in a time when
          craftsmanship was paramount, the house has witnessed the quiet rhythm of life in this
          historic town — from its 1167 royal charter to the present day.
        </p>
        <p>
          After years of careful planning, the house was meticulously renovated with deep respect
          for its original character. Every decision was made to preserve what makes it special:
          the thick stone walls that keep the house cool in summer, the high ceilings that lend an
          airy feel, the original terracotta floor tiles, and the exposed wooden structure that
          tells the story of traditional Portuguese construction.
        </p>
        <p>
          The result is a holiday home that feels both timeless and comfortable — a warm, inviting
          space where friends and family can gather, relax, and create memories.
        </p>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4">Living Spaces</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-stone-100 p-6">
          <h3 class="mb-2">Living Room</h3>
          <p class="text-muted text-sm font-body leading-relaxed">A cozy living room with a fireplace, perfect for cooler evenings. Comfortable seating, warm lighting, and a relaxed atmosphere.</p>
        </div>
        <div class="bg-stone-100 p-6">
          <h3 class="mb-2">Kitchen &amp; Dining</h3>
          <p class="text-muted text-sm font-body leading-relaxed">Fully equipped kitchen with oven, fridge, Nespresso machine, kettle, microwave, and all utensils. Dining area for shared meals.</p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4">Restoration Details</h2>
      <ul class="space-y-3 text-muted font-body">
        <li class="flex gap-3"><span class="text-terracotta-500">&mdash;</span> High ceilings preserved throughout the house</li>
        <li class="flex gap-3"><span class="text-terracotta-500">&mdash;</span> Original stone walls carefully restored</li>
        <li class="flex gap-3"><span class="text-terracotta-500">&mdash;</span> Traditional red terracotta floor tiles maintained</li>
        <li class="flex gap-3"><span class="text-terracotta-500">&mdash;</span> Exposed wooden ceiling structure kept as a feature</li>
        <li class="flex gap-3"><span class="text-terracotta-500">&mdash;</span> Thick walls provide natural insulation — cool in summer, warm in winter</li>
      </ul>
    </section>
  </div>

  <CTASection
    title="Experience Casa dos Duques"
    subtitle="Book your stay and discover the charm of this beautifully restored holiday home"
    primaryCta={{ label: 'Check availability', href: '/booking/' }}
    secondaryCta={{ label: 'See the rooms', href: '/rooms/' }}
    variant="wood"
  />
</BaseLayout>
