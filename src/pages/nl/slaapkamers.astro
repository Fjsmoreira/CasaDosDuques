---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
---

<BaseLayout
  title="Slaapkamers — Tot 8 Gasten Comfortabel Overnachten | Casa dos Duques"
  description="4 slaapkamers, 5 bedden, 3 badkamers bij Casa dos Duques. Eén master ensuite, één kinderen-slaapkamer en twee tweepersoonskamers. Slaapt tot 6 volwassenen + 2 kinderen + 1 baby."
  canonical="/nl/slaapkamers/"
  locale="nl"
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-wood-800 mb-4">Slaapkamers — Tot 8 Gasten Comfortabel Overnachten</h1>
    <p class="text-muted mb-8">4 slaapkamers · 5 bedden · 3 badkamers · Tot 8 gasten (6 volwassenen + 2 kinderen + 1 baby)</p>
    
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="bg-white border border-stone-300 overflow-hidden">
        <OptimizedImage src="/images/airbnb/a972d33d-086b-46ea-a63d-934ec57827ff.jpeg" alt="Kinderkamer met stapelbed" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 100vw, 50vw" />
        <div class="p-6">
          <h2 class="text-xl font-semibold text-wood-800 mb-2">Slaapkamer 1 — Kinderkamer</h2>
          <p class="text-sm text-muted mb-3">1 stapelbed · Slaapt 2</p>
          <p class="text-sm text-muted">Een gezellige kamer met een stapelbed, ideaal voor kinderen of extra gasten.</p>
        </div>
      </div>
      <div class="bg-white border border-stone-300 overflow-hidden">
        <OptimizedImage src="/images/airbnb/c1eb8904-37f7-4f82-99e7-cd539bafd98a.jpeg" alt="Tweepersoonskamer met traditioneel karakter" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 100vw, 50vw" />
        <div class="p-6">
          <h2 class="text-xl font-semibold text-wood-800 mb-2">Slaapkamer 2 — Tweepersoonskamer</h2>
          <p class="text-sm text-muted mb-3">1 tweepersoonsbed · Slaapt 2</p>
          <p class="text-sm text-muted">Comfortabele tweepersoonskamer met traditioneel karakter.</p>
        </div>
      </div>
      <div class="bg-white border border-stone-300 overflow-hidden">
        <OptimizedImage src="/images/airbnb/6cbce955-d2e0-480c-b318-7eb5e027eb85.jpeg" alt="Ruime tweepersoonskamer met uitzicht op de tuin" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 100vw, 50vw" />
        <div class="p-6">
          <h2 class="text-xl font-semibold text-wood-800 mb-2">Slaapkamer 3 — Tweepersoonskamer</h2>
          <p class="text-sm text-muted mb-3">1 tweepersoonsbed · Slaapt 2</p>
          <p class="text-sm text-muted">Ruime tweepersoonskamer met uitzicht op de tuin.</p>
        </div>
      </div>
      <div class="bg-white border border-stone-300 overflow-hidden">
        <OptimizedImage src="/images/airbnb/ba9a905b-2d7b-4741-ac8f-ceafe2288cf6.jpeg" alt="Master ensuite slaapkamer" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 100vw, 50vw" />
        <div class="p-6">
          <h2 class="text-xl font-semibold text-wood-800 mb-2">Slaapkamer 4 — Master Suite</h2>
          <p class="text-sm text-muted mb-3">1 tweepersoonsbed · Ensuite badkamer · Slaapt 2</p>
          <p class="text-sm text-muted">Master bedroom met eigen badkamer met bad. De meest privékamer van het huis.</p>
        </div>
      </div>
    </div>

    <section class="bg-wall-100 p-6 mb-12">
      <h2 class="text-2xl font-semibold text-wood-700 mb-4">Badkamers</h2>
      <ul class="space-y-2 text-muted">
        <li>Ensuite badkamer (Slaapkamer 4) — bad</li>
        <li>Gedeelde badkamer 1 — douche</li>
        <li>Gedeelde badkamer 2 — douche</li>
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-wood-700 mb-6">Slaapkamer Galerij</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <OptimizedImage src="/images/airbnb/a972d33d-086b-46ea-a63d-934ec57827ff.jpeg" alt="Slaapkamerinterieur van Casa dos Duques" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 33vw" />
        <OptimizedImage src="/images/airbnb/c1eb8904-37f7-4f82-99e7-cd539bafd98a.jpeg" alt="Slaapkamerinterieur van Casa dos Duques" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 33vw" />
        <OptimizedImage src="/images/airbnb/6cbce955-d2e0-480c-b318-7eb5e027eb85.jpeg" alt="Slaapkamerinterieur van Casa dos Duques" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 33vw" />
        <OptimizedImage src="/images/airbnb/ba9a905b-2d7b-4741-ac8f-ceafe2288cf6.jpeg" alt="Slaapkamerinterieur van Casa dos Duques" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 33vw" />
        <OptimizedImage src="/images/airbnb/04be686a-a4fe-484c-be4e-590aa81cf11a.jpeg" alt="Slaapkamerinterieur van Casa dos Duques" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 33vw" />
        <OptimizedImage src="/images/airbnb/1b5f5cec-a4ff-402a-b6a8-ac852df5f7a3.jpeg" alt="Slaapkamerinterieur van Casa dos Duques" class="h-48 w-full object-cover" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 50vw, 33vw" />
      </div>
    </section>
  </div>

  <CTASection
    title="Klaar om te Boeken?"
    subtitle="Controleer de beschikbaarheid voor uw gewenste kamerconfiguratie"
    primaryCta={{ label: 'Beschikbaarheid Controleren', href: '/nl/boeking/' }}
    variant="terracotta"
  />
</BaseLayout>
