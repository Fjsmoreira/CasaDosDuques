---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  title="Things to Do Near Pombal — Activities, Beaches, Day Trips in Central Portugal"
  description="The best things to do near Pombal and Abiul: UNESCO monasteries, beaches, castles, river beaches, hiking, food, and family activities — all within easy reach of Casa dos Duques."
  canonical="/things-to-do/"
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Things to do</p>
    <h1 class="mb-6">Things to Do Near Pombal</h1>
    <p class="text-muted font-body leading-relaxed mb-10">
      Whether you love history, nature, beaches, or food — Casa dos Duques is the perfect base
      for an unforgettable holiday in Central Portugal.
    </p>

    <section class="mb-10">
      <h2 class="mb-5">Castles &amp; History</h2>
      <div class="space-y-3">
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Pombal Castle <span class="text-sm text-terracotta-500 font-normal font-body">10 min</span></h3>
          <p class="text-sm text-muted font-body">12th-century Knights Templar castle with panoramic views</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Batalha Monastery <span class="text-sm text-terracotta-500 font-normal font-body">30 min — UNESCO</span></h3>
          <p class="text-sm text-muted font-body">Gothic masterpiece with the famous Unfinished Chapels</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Tomar — Convent of Christ <span class="text-sm text-terracotta-500 font-normal font-body">40 min — UNESCO</span></h3>
          <p class="text-sm text-muted font-body">Knights Templar fortress with the stunning Manueline window</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Con&iacute;mbriga Roman Ruins <span class="text-sm text-terracotta-500 font-normal font-body">40 min</span></h3>
          <p class="text-sm text-muted font-body">Best-preserved Roman settlement in Portugal</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5">Beaches &amp; Coast</h2>
      <div class="space-y-3">
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Praia da Leirosa <span class="text-sm text-terracotta-500 font-normal font-body">37 min</span></h3>
          <p class="text-sm text-muted font-body">Closest beach — quiet sandy beach perfect for an afternoon</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Praia do Osso da Baleia <span class="text-sm text-terracotta-500 font-normal font-body">38 min</span></h3>
          <p class="text-sm text-muted font-body">In Pombal municipality itself</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Figueira da Foz <span class="text-sm text-terracotta-500 font-normal font-body">47 min</span></h3>
          <p class="text-sm text-muted font-body">Major beach resort with a 2km sandy beach, casino, promenade</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Nazar&eacute; <span class="text-sm text-terracotta-500 font-normal font-body">65 min</span></h3>
          <p class="text-sm text-muted font-body">World-famous giant waves and excellent seafood</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5">River Beaches</h2>
      <div class="space-y-3">
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Praia Fluvial do Mosteiro <span class="text-sm text-terracotta-500 font-normal font-body">50 min</span></h3>
          <p class="text-sm text-muted font-body">Sandy river beach in a beautiful schist village setting</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Penedo Furado <span class="text-sm text-terracotta-500 font-normal font-body">60 min</span></h3>
          <p class="text-sm text-muted font-body">Spectacular waterfall with natural swimming pools</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5">Nature &amp; Hiking</h2>
      <div class="space-y-3">
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Aldeias do Xisto <span class="text-sm text-terracotta-500 font-normal font-body">45–60 min</span></h3>
          <p class="text-sm text-muted font-body">Traditional schist villages with walking trails and river beaches</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Serra da Estrela Natural Park <span class="text-sm text-terracotta-500 font-normal font-body">~2 h</span></h3>
          <p class="text-sm text-muted font-body">Portugal&rsquo;s highest mountain range — hiking, snow, and stunning views</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Mira de Aire Caves <span class="text-sm text-terracotta-500 font-normal font-body">35 min</span></h3>
          <p class="text-sm text-muted font-body">Impressive limestone cave system with underground lakes</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5">Food &amp; Wine</h2>
      <div class="space-y-3">
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Restaurants in Abiul <span class="text-sm text-terracotta-500 font-normal font-body">Walking distance</span></h3>
          <p class="text-sm text-muted font-body">Casa dos Bispos (regional) and Quinta das Vinhas (3 min drive)</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Pombal Dining <span class="text-sm text-terracotta-500 font-normal font-body">10 min</span></h3>
          <p class="text-sm text-muted font-body">6 restaurants including regional grill, pizza, Chinese, and traditional taberna</p>
        </div>
        <div class="bg-white border border-stone-200 p-4">
          <h3 class="text-base">Nazar&eacute; Seafood <span class="text-sm text-terracotta-500 font-normal font-body">65 min</span></h3>
          <p class="text-sm text-muted font-body">Fresh fish and seafood in the fishing quarter</p>
        </div>
      </div>
    </section>
  </div>

  <CTASection
    title="Ready for adventure?"
    subtitle="Book Casa dos Duques and explore the best of Central Portugal"
    primaryCta={{ label: 'Book your stay', href: '/booking/' }}
    secondaryCta={{ label: 'View day trips', href: '/day-trips/' }}
    variant="wood"
  />
</BaseLayout>
