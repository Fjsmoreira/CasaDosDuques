const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'Que visiter autour de Pombal : plages, thermes et villages authentiques',
      description: 'Plages de l\'Atlantique à 30-45 minutes, thermes, châteaux templiers et villages authentiques : tout ce qu\'il y a à voir autour de Pombal, dans le Centre du Portugal, depuis la Casa dos Duques.',
      author: { '@type': 'Person', name: 'Casa dos Duques' },
      datePublished: '2026-08-12',
      dateModified: '2026-08-12',
      image: 'https://casadosduques.pt/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg',
      publisher: { '@type': 'Organization', name: 'Casa dos Duques' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://casadosduques.pt/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://casadosduques.pt/fr/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Que visiter autour de Pombal', item: canonicalUrl },
      ],
    },
  ],
