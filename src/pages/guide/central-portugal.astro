---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://casadosduques.pt/' },
    { '@type': 'ListItem', position: 2, name: 'Explore Central Portugal', item: 'https://casadosduques.pt/guide/central-portugal/' },
  ],
};
---

<BaseLayout
  title="Explore Central Portugal — Beaches, Castles & UNESCO Heritage from Pombal"
  description="Explore the best of Central Portugal from Casa dos Duques: 4 UNESCO sites within 30 min, stunning beaches, medieval castles, Roman ruins. Your perfect holiday base."
  canonical="/guide/central-portugal/"
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Guide</p>
    <h1 class="mb-6">Explore Central Portugal</h1>
    <p class="text-muted font-body leading-relaxed mb-10">
      Casa dos Duques is perfectly located to explore the very best of Central Portugal.
      Four UNESCO World Heritage sites are within a 30-minute drive, and stunning beaches
      are just 35&ndash;40 minutes away. Here are our top recommendations.
    </p>

    <section class="mb-10">
      <h2 class="mb-5">UNESCO World Heritage Sites</h2>
      <div class="grid md:grid-cols-2 gap-5 mb-10">
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Batalha Monastery</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">30 min — UNESCO</p>
          <p class="text-sm text-muted font-body">A Gothic masterpiece built to commemorate Portugal&rsquo;s victory at the 1385 Battle of Aljubarrota. Don&rsquo;t miss the Unfinished Chapels.</p>
        </div>
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Alcoba&ccedil;a Monastery</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">30 min — UNESCO</p>
          <p class="text-sm text-muted font-body">A Cistercian abbey founded in 1153, housing the ornate tombs of King Pedro I and In&ecirc;s de Castro — Portugal&rsquo;s tragic love story.</p>
        </div>
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Tomar — Convent of Christ</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">30 min — UNESCO</p>
          <p class="text-sm text-muted font-body">A Knights Templar fortress-monastery with the famous 16th-century Manueline window. One of Portugal&rsquo;s most extraordinary architectural works.</p>
        </div>
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Coimbra University</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">40 min — UNESCO</p>
          <p class="text-sm text-muted font-body">One of Europe&rsquo;s oldest universities (1290), with the stunning Joanina Library and Baroque University tower overlooking the city.</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5">Beaches &amp; Coast</h2>
      <div class="grid md:grid-cols-2 gap-5 mb-10">
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Figueira da Foz</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">47 min — Beach resort</p>
          <p class="text-sm text-muted font-body">The largest beach resort in central Portugal with a 2km sandy beach, casino, and excellent restaurants.</p>
        </div>
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Nazar&eacute;</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">65 min — Big waves</p>
          <p class="text-sm text-muted font-body">World-famous for giant waves up to 30m. Visit the clifftop promenade and enjoy fresh seafood in the fishing quarter.</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5">River Beaches</h2>
      <p class="text-muted font-body mb-4">No sea? No problem. Central Portugal has stunning river beaches with crystal-clear water:</p>
      <div class="grid md:grid-cols-2 gap-5 mb-10">
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Praia Fluvial do Mosteiro</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">50 min — Pedr&oacute;g&atilde;o Grande</p>
          <p class="text-sm text-muted font-body">Sandy river beach in a beautiful schist village setting. Perfect for a peaceful river swim.</p>
        </div>
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Penedo Furado</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">60 min — Vila de Rei</p>
          <p class="text-sm text-muted font-body">Spectacular waterfall with natural pools. One of the most beautiful river beaches in Central Portugal.</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5">History &amp; Ruins</h2>
      <div class="grid md:grid-cols-2 gap-5 mb-10">
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Con&iacute;mbriga</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">35 min — Roman ruins</p>
          <p class="text-sm text-muted font-body">The best-preserved Roman settlement in Portugal, with extensive mosaic floors, thermal baths, and an aqueduct.</p>
        </div>
        <div class="bg-white border border-stone-200 p-5">
          <h3 class="text-lg mb-1">Leiria Castle</h3>
          <p class="text-sm text-terracotta-500 font-semibold mb-2 font-body">25 min — Medieval</p>
          <p class="text-sm text-muted font-body">A hilltop 12th-century castle with a compact historic centre and riverside promenade below.</p>
        </div>
      </div>
    </section>
  </div>

  <CTASection
    title="Your Central Portugal adventure awaits"
    subtitle="Book Casa dos Duques and explore it all"
    primaryCta={{ label: 'Book your stay', href: '/booking/' }}
    variant="terracotta"
  />
</BaseLayout>
