---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://casadosduques.pt/' },
    { '@type': 'ListItem', position: 2, name: 'Guide to Pombal', item: 'https://casadosduques.pt/guide/pombal/' },
  ],
};
---

<BaseLayout
  title="Guide to Pombal — Castle, Restaurants & Everything You Need"
  description="Complete guide to Pombal: medieval Knights Templar castle, Marquês de Pombal connection, best restaurants, supermarkets, and services — just 10 min from Casa dos Duques."
  canonical="/guide/pombal/"
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Guide</p>
    <h1 class="mb-6">Pombal — Castle, Culture &amp; Everyday Convenience</h1>

    <section class="mb-10">
      <h2 class="mb-4">Pombal Castle</h2>
      <div class="font-body text-muted leading-relaxed space-y-3">
        <p>
          Dominating the town&rsquo;s skyline, Pombal Castle is a magnificent medieval fortress built by the
          Knights Templar in the 12th century. It was part of a defensive line protecting the
          Coimbra-Leiria region during the Reconquista. The castle offers panoramic views of the
          surrounding countryside and is a must-visit during your stay.
        </p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4">Marqu&ecirc;s de Pombal</h2>
      <div class="font-body text-muted leading-relaxed space-y-3">
        <p>
          The town gave its name to Sebasti&atilde;o Jos&eacute; de Carvalho e Melo, the 1st Marqu&ecirc;s de Pombal,
          the powerful 18th-century prime minister who rebuilt Lisbon after the devastating 1755
          earthquake. His legacy is deeply connected to this region and the famous T&aacute;vora affair.
        </p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4">Eating Out in Pombal</h2>
      <p class="text-muted font-body mb-4">A 10-minute drive from Casa dos Duques, Pombal offers excellent dining options:</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Churrasqueira O Tapa</span>
          <span class="text-muted block font-body">Regional grill &middot; +351 236 213 581</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Vintage</span>
          <span class="text-muted block font-body">Regional cuisine &middot; +351 236 244 033</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Mr Pizza</span>
          <span class="text-muted block font-body">Pizza &middot; Mo&ndash;Sa 12:00&ndash;23:00 &middot; +351 236 244 333</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Taberna Pombalina</span>
          <span class="text-muted block font-body">Regional &middot; Su&ndash;Fr 08:30&ndash;20:00 &middot; +351 236 094 360</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Big Shanghai</span>
          <span class="text-muted block font-body">Chinese &middot; +351 236 207 846</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Rei dos Frangos</span>
          <span class="text-muted block font-body">Grilled chicken</span>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4">Shopping &amp; Services</h2>
      <ul class="space-y-2 text-sm text-muted font-body">
        <li><strong class="text-wood-800">Aldi</strong> — Supermarket, daily 08:00&ndash;21:00</li>
        <li><strong class="text-wood-800">Dias</strong> — Supermarket</li>
        <li><strong class="text-wood-800">Multiple ATMs</strong> — SIBS Multibanco, Cr&eacute;dito Agr&iacute;cola, Santander</li>
      </ul>
    </section>
  </div>

  <CTASection
    title="Discover Pombal from Casa dos Duques"
    subtitle="Just 10 minutes away — book your stay and explore"
    primaryCta={{ label: 'Book your stay', href: '/booking/' }}
    secondaryCta={{ label: 'See things to do', href: '/things-to-do/' }}
    variant="terracotta"
  />
</BaseLayout>
