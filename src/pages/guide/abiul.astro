---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://casadosduques.pt/' },
    { '@type': 'ListItem', position: 2, name: 'Guide to Abiul', item: 'https://casadosduques.pt/guide/abiul/' },
  ],
};
---

<BaseLayout
  title="Guide to Abiul — History, Culture & Practical Info | Pombal, Portugal"
  description="Complete guide to Abiul, Pombal: 1167 royal charter, oldest bullring in Portugal, Festa do Bodo tradition, and practical tips for visitors staying at Casa dos Duques."
  canonical="/guide/abiul/"
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold text-terracotta-500 tracking-widest uppercase mb-3 font-body">Guide</p>
    <h1 class="mb-6">Abiul — History, Culture &amp; Practical Info</h1>

    <section class="mb-10">
      <h2 class="mb-4">A Town with Royal Heritage</h2>
      <div class="font-body text-muted leading-relaxed space-y-3">
        <p>
          Abiul received its first royal charter (foral) in 1167 from King Afonso Henriques, making
          it one of the oldest documented settlements in the Pombal region. This medieval heritage
          is woven into the town&rsquo;s fabric — from its narrow streets and traditional architecture to
          its enduring traditions.
        </p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4">Historical Highlights</h2>
      <div class="space-y-4">
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Oldest Bullring in Portugal</h3>
          <p class="text-sm text-muted font-body">Abiul is home to what is believed to be the oldest bullring (pra&ccedil;a de touros) in Portugal, a testament to the town&rsquo;s deep-rooted cultural traditions.</p>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">House of Aveiro Connection</h3>
          <p class="text-sm text-muted font-body">Abiul was historically linked to the powerful House of Aveiro, a noble family that played a significant role in Portuguese history until the T&aacute;vora affair in the 18th century.</p>
        </div>
        <div class="bg-stone-100 p-5">
          <h3 class="mb-1">Festa do Bodo</h3>
          <p class="text-sm text-muted font-body">Abiul&rsquo;s most important traditional festival, originating from a medieval plague-vow tradition. The community promised to hold an annual feast in gratitude for being spared from the Black Death — a tradition that continues to this day.</p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4">Practical Information</h2>
      <p class="text-muted font-body mb-4">Everything within walking distance from Casa dos Duques:</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Villa Cafe</span>
          <span class="text-muted block font-body">24 m — coffee and snacks</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">F&aacute;tima Mini-Market</span>
          <span class="text-muted block font-body">29 m — daily essentials</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Farm&aacute;cia Pharmacy</span>
          <span class="text-muted block font-body">49 m</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Casa dos Bispos</span>
          <span class="text-muted block font-body">137 m — restaurant</span>
        </div>
        <div class="bg-white border border-stone-200 p-3 text-sm">
          <span class="font-semibold text-wood-800">Cr&eacute;dito Agr&iacute;cola</span>
          <span class="text-muted block font-body">147 m — bank + ATM</span>
        </div>
      </div>
    </section>
  </div>

  <CTASection
    title="Stay in the heart of history"
    subtitle="Book Casa dos Duques and experience authentic Abiul"
    primaryCta={{ label: 'Book your stay', href: '/booking/' }}
    secondaryCta={{ label: 'Explore Pombal', href: '/guide/pombal/' }}
    variant="wood"
  />
</BaseLayout>
