---
export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'terracotta' | 'wood' | 'wall';
}

const { title, subtitle, primaryCta, secondaryCta, variant = 'terracotta' } = Astro.props;

const bgClasses: Record<string, string> = {
  terracotta: 'bg-terracotta-600 text-white',
  wood: 'bg-wood-800 text-white',
  wall: 'bg-wall-200 text-wood-800',
};

const primaryBtnClasses: Record<string, string> = {
  terracotta: 'bg-white text-terracotta-700 hover:bg-wall-100',
  wood: 'bg-terracotta-500 text-white hover:bg-terracotta-600',
  wall: 'bg-terracotta-500 text-white hover:bg-terracotta-600',
};

const secondaryBtnClasses: Record<string, string> = {
  terracotta: 'border-white/40 text-white hover:bg-white/10',
  wood: 'border-white/40 text-white hover:bg-white/10',
  wall: 'border-stone-400 text-wood-700 hover:bg-stone-200',
};
---

<section class={`${bgClasses[variant]} py-16 md:py-20`}>
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="mb-3">{title}</h2>
    {subtitle && <p class="text-base md:text-lg opacity-80 mb-8 font-body">{subtitle}</p>}
    <div class="flex flex-wrap gap-4 justify-center">
      <a href={primaryCta.href} class={`inline-block font-semibold px-7 py-3 text-sm transition-colors ${primaryBtnClasses[variant]}`}>
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class={`inline-block font-semibold px-7 py-3 text-sm border transition-colors ${secondaryBtnClasses[variant]}`}>
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>
