---
import OptimizedImage from './OptimizedImage.astro';

export interface Props {
  title: string;
  subtitle?: string;
  tagline?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  image?: string;
}

const {
  title,
  subtitle,
  tagline,
  primaryCta,
  secondaryCta,
  image = '/images/airbnb/467c6107-9824-44ec-98f5-fcc2d62cb186.jpeg',
} = Astro.props;
---

<section class="relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
  <div class="absolute inset-0">
    <OptimizedImage
      src={image}
      alt="Casa dos Duques — holiday home with pool and garden in Abiul, Central Portugal"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width={1200}
      height={800}
    />
    <!-- Subtle gradient only at the bottom third for text legibility -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/15 to-transparent" />
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-4 pb-12 md:pb-16">
    <div class="max-w-2xl">
      <h1 class="text-white mb-3 leading-none">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg md:text-xl text-white/85 font-body mb-4">{subtitle}</p>
      )}
      {tagline && (
        <p class="text-sm md:text-base text-white/70 font-body mb-6">{tagline}</p>
      )}
      <div class="flex flex-wrap gap-4">
        {primaryCta && (
          <a
            href={primaryCta.href}
            class="inline-block bg-terracotta-500 hover:bg-terracotta-600 text-white font-semibold px-7 py-3 text-sm transition-colors"
          >
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="inline-block bg-white/15 hover:bg-white/25 backdrop-blur-sm text-white font-semibold px-7 py-3 text-sm border border-white/30 transition-colors"
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
