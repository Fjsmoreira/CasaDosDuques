---
import OptimizedImage from './OptimizedImage.astro';

interface Card {
  icon?: string;
  title: string;
  description: string;
  href?: string;
  image?: string;
}

export interface Props {
  cards: Card[];
  columns?: 2 | 3 | 4;
  variant?: 'default' | 'compact';
}

const { cards, columns = 3, variant = 'default' } = Astro.props;
const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
};
---

<div class={`grid grid-cols-1 ${gridCols[columns]} gap-5`}>
  {cards.map(card => (
    <div class={`bg-white border border-stone-200 hover:border-stone-400 hover:shadow-sm transition ${variant === 'compact' ? 'p-4' : 'p-6'}`}>
      {card.image && (
        <OptimizedImage src={card.image} alt="" class="w-full h-48 object-cover mb-4" loading="lazy" width={400} height={300} sizes="(max-width: 768px) 100vw, 33vw" />
      )}
      {card.icon && <div class="text-2xl mb-3">{card.icon}</div>}
      <h3 class={`font-medium text-wood-800 ${variant === 'compact' ? 'text-sm' : 'text-xl'} mb-2`}>
        {card.href ? <a href={card.href} class="hover:text-terracotta-500 transition-colors">{card.title}</a> : card.title}
      </h3>
      <p class={`text-muted font-body ${variant === 'compact' ? 'text-xs' : 'text-sm'} leading-relaxed`}>{card.description}</p>
    </div>
  ))}
</div>
